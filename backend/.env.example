# 실제 값은 .env(깃 무시됨)나 배포 환경의 비밀관리에만 넣으세요. 이 파일에는 절대 실제 키를 쓰지 마세요.
VLM_BASE_URL=https://<your-host>/v1
VLM_API_KEY=
VLM_MODEL=qwen3.8-vl
VLM_REASONING_EFFORT=low

TTS_BASE_URL=http://127.0.0.1:8001/v1
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_FORMAT=mp3

# 프런트엔드를 다른 도메인에서 열 때만 (쉼표 구분). 같은 서버의 /sim.html, /index.html 로 열면 비워 둡니다.
ALLOWED_ORIGINS=
